rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    // Con Google, el email del token siempre viene verificado por Google.
    // Con email/contraseña ya no es así: cualquiera puede registrarse con
    // el email de otra persona, así que en cualquier sitio donde se confía
    // en request.auth.token.email para resolver una identidad (portal de
    // clientes, colaboradores) hay que exigir también que esté verificado.
    function isVerifiedEmail(email) {
      return isAuth() && request.auth.token.email_verified == true &&
        request.auth.token.email == email;
    }

    function isSuperAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    function isMemberOf(firmId) {
      return isAuth() &&
        exists(/databases/$(database)/documents/firms/$(firmId)/members/$(request.auth.uid));
    }

    function getMember(firmId) {
      return get(/databases/$(database)/documents/firms/$(firmId)/members/$(request.auth.uid)).data;
    }

    function hasRole(firmId, roles) {
      return isMemberOf(firmId) && getMember(firmId).role in roles;
    }

    function isOwner(firmId) {
      return hasRole(firmId, ['firm_owner']);
    }

    function isOwnerOrDirector(firmId) {
      return hasRole(firmId, ['firm_owner', 'firm_director']);
    }

    function isActiveMember(firmId) {
      return isMemberOf(firmId) && getMember(firmId).isActive == true;
    }

    // Colaborador (Fase 5, §4.5) con cuenta propia vinculada a este
    // colaboratingFirms concreto — usado para dar acceso de solo lectura/
    // creación a los expedientes donde le hayan asignado, nunca al resto
    // del despacho.
    function isLinkedCollaborator(firmId, collaboratorId) {
      return isAuth() && collaboratorId != null &&
        get(/databases/$(database)/documents/firms/$(firmId)/collaboratingFirms/$(collaboratorId)).data.linkedUserId == request.auth.uid;
    }

    // Igual que isLinkedCollaborator pero para una subcolección de
    // cases/{caseId} — resuelve primero el collaboratingFirmId del
    // expediente padre.
    function isLinkedCollaboratorOnCase(firmId, caseId) {
      let cf = get(/databases/$(database)/documents/firms/$(firmId)/cases/$(caseId)).data.collaboratingFirmId;
      return isLinkedCollaborator(firmId, cf);
    }

    // Cliente de portal con acceso activo a este expediente concreto — el
    // ID de cada documento en portalAccess es el email normalizado del
    // cliente, así que basta comprobar que existe uno con su propio email
    // verificado y sigue activo. Usado tanto por cases (lectura directa)
    // como por quotes (el presupuesto de origen de su propio expediente).
    function isPortalClientForCase(firmId, caseId) {
      return isAuth() && request.auth.token.email_verified == true &&
        exists(/databases/$(database)/documents/firms/$(firmId)/cases/$(caseId)/portalAccess/$(request.auth.token.email)) &&
        get(/databases/$(database)/documents/firms/$(firmId)/cases/$(caseId)/portalAccess/$(request.auth.token.email)).data.isActive == true;
    }

    // ─── PLATFORM ADMINS ─────────────────────────────────────────────────────

    match /platformAdmins/{userId} {
      allow read: if isSuperAdmin() || request.auth.uid == userId;
      allow write: if isSuperAdmin();
    }

    // ─── USER FIRM INDEX ─────────────────────────────────────────────────────

    match /userFirmIndex/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if isAuth() && request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ─── COLLABORATOR INDEX ──────────────────────────────────────────────────
    // Mismo patrón que userFirmIndex: índice por uid de a qué despachos
    // colabora este usuario. No es la fuente de autorización real — eso lo
    // decide `collaboratingFirms/{id}.linkedUserId` en cada despacho (ver
    // isLinkedCollaborator) — así que basta con que cada uno gestione su
    // propio índice, igual que portalClients no necesita más.
    match /collaboratorIndex/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow write: if isAuth() && request.auth.uid == userId;
      allow delete: if isSuperAdmin();
    }

    // ─── MEMBER INVITES ──────────────────────────────────────────────────────
    // Índice top-level (doc ID = email normalizado) que vincula la cuenta
    // futura de un miembro invitado por email (firms/{firmId}/members creado
    // desde TeamTab → addMember) con ese documento de miembro concreto, para
    // que AuthContext.resolveUserType lo encuentre sin necesitar una query —
    // mismo problema que portalClients/collaboratingFirms resuelven por
    // email verificado, ver isVerifiedEmail. No es la fuente de autorización
    // real (esa es members/{memberId}.userId) — se borra en el momento de
    // vincular (claimMemberInvite), así que su sola existencia ya implica
    // "invitación pendiente sin reclamar". No listable: solo se permite
    // leer/borrar el documento propio por ID exacto.
    match /memberInvites/{email} {
      allow get: if isSuperAdmin() ||
        isVerifiedEmail(email) ||
        (isAuth() && isOwnerOrDirector(resource.data.firmId));
      allow create: if isSuperAdmin() || isOwnerOrDirector(request.resource.data.firmId);
      allow delete: if isSuperAdmin() ||
        isVerifiedEmail(email) ||
        (isAuth() && isOwnerOrDirector(resource.data.firmId));
    }

    // ─── PORTAL CLIENTS ──────────────────────────────────────────────────────

    // Antes: create/update sin ninguna comprobación de quién escribe, lo
    // que permitía a cualquier usuario autenticado añadirse a sí mismo
    // firmIds/caseIds arbitrarios en su propio registro (y de ahí acceder
    // a expedientes de despachos y clientes ajenos). Lectura se deja
    // abierta a autenticados a propósito — este documento solo guarda un
    // índice (email/nombre/IDs), no contenido del expediente, y así se
    // evita reconstruir aquí la lógica multi-despacho de comprobar
    // pertenencia a "cualquiera de los firmIds del array".
    match /portalClients/{docId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && request.resource.data.firmIds.size() > 0
        && isActiveMember(request.resource.data.firmIds[0]);
      allow update: if isSuperAdmin()
        || (
          isAuth() &&
          request.resource.data.firmIds.size() > 0 &&
          isActiveMember(request.resource.data.firmIds[request.resource.data.firmIds.size() - 1])
        )
        || (
          isVerifiedEmail(resource.data.email) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['userId', 'lastAccessAt'])
        );
      allow delete: if isSuperAdmin();
    }

    // ─── PLANS ───────────────────────────────────────────────────────────────

    match /plans/{planId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── PLATFORM SETTINGS ───────────────────────────────────────────────────

    match /platformSettings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ─── SUPPORT TICKETS ─────────────────────────────────────────────────────

    match /supportTickets/{ticketId} {
      allow read: if isSuperAdmin() ||
        (isAuth() && resource.data.userId == request.auth.uid);
      allow create: if isAuth();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ─── AUDIT PLATFORM ──────────────────────────────────────────────────────

    match /auditPlatform/{logId} {
      allow read: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ─── FIRMS ───────────────────────────────────────────────────────────────

    match /firms/{firmId} {
      allow read: if isSuperAdmin() || isActiveMember(firmId);
      allow create: if isAuth();
      allow update: if isSuperAdmin() || isOwnerOrDirector(firmId);
      allow delete: if isSuperAdmin();

      // ── MEMBERS ──────────────────────────────────────────────────────────

      match /members/{memberId} {
        // La persona invitada por email (invitationStatus == 'pendiente',
        // ver memberInvites y claimMemberInvite) puede leer/reclamar SU
        // PROPIO documento de miembro comparando contra su email verificado
        // (isVerifiedEmail) antes de tener sesión activa en el despacho —
        // nunca puede listar ni leer los de otros miembros.
        allow read: if isSuperAdmin() || isActiveMember(firmId) || (
          ('invitationStatus' in resource.data) &&
          resource.data.invitationStatus == 'pendiente' &&
          isVerifiedEmail(resource.data.email)
        );
        allow create: if isSuperAdmin() ||
          isOwnerOrDirector(firmId) ||
          (isAuth() && request.auth.uid == request.resource.data.userId);
        allow update: if isSuperAdmin() ||
          isOwnerOrDirector(firmId) ||
          (isAuth() && resource.data.userId == request.auth.uid) ||
          (
            ('invitationStatus' in resource.data) &&
            resource.data.invitationStatus == 'pendiente' &&
            isVerifiedEmail(resource.data.email) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['userId', 'invitationStatus', 'updatedAt']) &&
            request.resource.data.userId == request.auth.uid &&
            request.resource.data.invitationStatus == 'aceptada'
          );
        allow delete: if isSuperAdmin() || isOwner(firmId);
      }

      // ── BRANCHES ─────────────────────────────────────────────────────────

      match /branches/{branchId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isSuperAdmin() || isOwnerOrDirector(firmId);
        allow update: if isSuperAdmin() || isOwnerOrDirector(firmId);
        allow delete: if isSuperAdmin() || isOwner(firmId);
      }

      // ── CLIENTS ──────────────────────────────────────────────────────────

      match /clients/{clientId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
      }

      // ── CONTACTS ─────────────────────────────────────────────────────────

      match /contacts/{contactId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
      }

      // ── QUOTES (presupuestos) ────────────────────────────────────────────

      match /quotes/{quoteId} {
        // Antes solo leían miembros del despacho — el portal de clientes
        // nunca podía cargar el expediente que viniera de un presupuesto
        // (la inmensa mayoría) porque useClientPortal() también resuelve
        // getQuote(firmId, case.quoteId), y esa lectura fallaba con
        // permission-denied, tirando abajo toda la pantalla del cliente.
        allow read: if isSuperAdmin() || isActiveMember(firmId) || (
          resource.data.caseId != null &&
          isPortalClientForCase(firmId, resource.data.caseId)
        );
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
      }

      // ── CASES ────────────────────────────────────────────────────────────

      match /cases/{caseId} {
        // Antes: "|| isAuth()" dejaba leer CUALQUIER expediente de CUALQUIER
        // despacho a cualquier usuario con sesión iniciada (un cliente del
        // portal, o un empleado de otro despacho). El acceso de un cliente
        // del portal ahora se comprueba de verdad: debe existir un
        // portalAccess activo para este expediente cuyo ID sea su propio
        // email verificado por Google (ver el bloque portalAccess más abajo,
        // donde el ID del documento pasó a ser el email en vez de aleatorio).
        allow read: if isSuperAdmin() || isActiveMember(firmId) ||
          isPortalClientForCase(firmId, caseId) || (
          resource.data.collaboratingFirmId != null &&
          isLinkedCollaborator(firmId, resource.data.collaboratingFirmId)
        );
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin() || isOwner(firmId);

        // Actuaciones — un colaborador con plataforma asignado al
        // expediente padre puede leer y añadir, nunca editar/borrar las
        // de otros ni las suyas ya guardadas.
        match /actions/{actionId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId) || isLinkedCollaboratorOnCase(firmId, caseId);
          allow create: if isActiveMember(firmId) || isLinkedCollaboratorOnCase(firmId, caseId);
          allow update: if isActiveMember(firmId);
          allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
        }

        // Informes
        match /reports/{reportId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId);
          allow create: if isActiveMember(firmId);
          allow update: if isActiveMember(firmId);
          allow delete: if isSuperAdmin() || isOwner(firmId);
        }

        // Sujetos investigados
        match /subjects/{subjectId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId);
          allow create: if isActiveMember(firmId);
          allow update: if isActiveMember(firmId);
          allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
        }

        // Hojas de encargo
        match /assignmentOrders/{orderId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId);
          allow create: if isActiveMember(firmId);
          allow update: if isActiveMember(firmId);
          allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
        }

        // Portal — accesos. El ID de cada documento es el email normalizado
        // del cliente (no un ID aleatorio) precisamente para poder hacer
        // esta comprobación exacta sin un "|| isAuth()" genérico.
        match /portalAccess/{accessId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId) || isVerifiedEmail(accessId);
          allow create: if isActiveMember(firmId);
          allow update: if isActiveMember(firmId);
          allow delete: if isOwnerOrDirector(firmId) || isSuperAdmin();
        }

        // Audit logs por expediente — inmutables
        match /auditLogs/{logId} {
          allow read: if isSuperAdmin() || isActiveMember(firmId);
          allow create: if isActiveMember(firmId);
          allow update: if false;
          allow delete: if false;
        }
      }

      // ── CONTRACTS ────────────────────────────────────────────────────────

      match /contracts/{contractId} {
        // Lectura individual pública: el link de firma solo funciona para
        // quien conoce el ID del contrato (aleatorio, no listable, no
        // adivinable) — no se permite listar/consultar sin autenticación.
        allow get: if true;
        allow list: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isActiveMember(firmId);
        // Firma pública por link: solo puede pasar de no firmado a firmado,
        // solo tocando los campos de la firma, y signedAt debe ser el
        // instante real del servidor (no se puede falsear la fecha).
        allow update: if isActiveMember(firmId) || (
          resource.data.status != 'firmado' &&
          request.resource.data.status == 'firmado' &&
          request.resource.data.signedAt == request.time &&
          request.resource.data.signedByName is string &&
          request.resource.data.signedByName.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'signedAt', 'signedByName', 'signedIp'])
        );
        allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
      }

      // ── FRAMEWORK CONTRACTS ──────────────────────────────────────────────

      match /frameworkContracts/{contractId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isOwnerOrDirector(firmId) || isSuperAdmin();
        allow update: if isOwnerOrDirector(firmId) || isSuperAdmin();
        allow delete: if isSuperAdmin() || isOwner(firmId);
      }

      // ── COLLABORATING FIRMS ──────────────────────────────────────────────

      match /collaboratingFirms/{collabId} {
        // La persona invitada (tienePlataforma) puede leer/aceptar SU
        // PROPIA invitación comparando contra su email verificado
        // (isVerifiedEmail — con Google siempre lo está; con email/
        // contraseña, solo tras confirmar el enlace de verificación) —
        // nunca puede listar ni leer las de otros.
        allow read: if isSuperAdmin() || isActiveMember(firmId) || (
          resource.data.tienePlataforma == true &&
          isVerifiedEmail(resource.data.invitedEmail)
        );
        allow create: if isOwnerOrDirector(firmId) || isSuperAdmin();
        allow update: if isOwnerOrDirector(firmId) || isSuperAdmin() || (
          resource.data.tienePlataforma == true &&
          resource.data.invitationStatus == 'pendiente' &&
          isVerifiedEmail(resource.data.invitedEmail) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['invitationStatus', 'linkedUserId', 'linkedUserEmail']) &&
          request.resource.data.invitationStatus == 'aceptada' &&
          request.resource.data.linkedUserId == request.auth.uid &&
          request.resource.data.linkedUserEmail == request.auth.token.email
        );
        allow delete: if isSuperAdmin() || isOwner(firmId);
      }

      // ── REGISTRY BOOKS ───────────────────────────────────────────────────

      match /registryBooks/{bookId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin();
      }

      // ── ANNUAL MEMORIES ──────────────────────────────────────────────────

      match /annualMemories/{memoryId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isOwnerOrDirector(firmId) || isSuperAdmin();
        allow update: if isOwnerOrDirector(firmId) || isSuperAdmin();
        allow delete: if isSuperAdmin();
      }

      // ── AUDIT LOGS DEL DESPACHO ───────────────────────────────────────────

      match /auditLogs/{logId} {
        allow read: if isSuperAdmin() ||
          hasRole(firmId, ['firm_owner', 'firm_director', 'compliance_officer']);
        allow create: if isActiveMember(firmId);
        allow update: if false;
        allow delete: if false;
      }

      // ── CLIENT PORTAL MESSAGES (legacy) ──────────────────────────────────

      match /clientPortalMessages/{messageId} {
        allow read: if isSuperAdmin() || isActiveMember(firmId);
        allow create: if isActiveMember(firmId);
        allow update: if isActiveMember(firmId);
        allow delete: if isSuperAdmin() || isOwnerOrDirector(firmId);
      }
    }
  }
}